            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            word-break: break-word;
        }

        /* Code / App-Ads.txt Box */
        .code-box {
            background: #04070e;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            position: relative;
            font-family: monospace;
            font-size: 13px;
            color: #38bdf8;
            margin-top: 16px;
            overflow-x: auto;
        }

        .copy-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-btn:hover {
            background: var(--primary);
            color: #070b14;
        }

        /* Legal Tabs & Content */
        .tab-nav {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .tab-btn {
            padding: 10px 24px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--primary);
            color: #070b14;
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .legal-content {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 40px;
            color: #cbd5e1;
            font-size: 14px;
            line-height: 1.8;
            display: none;
        }

        .legal-content.active {
            display: block;
        }

        .legal-content h3 {
            font-size: 24px;
            color: #ffffff;
            margin-bottom: 16px;
        }

        .legal-content h4 {
            font-size: 17px;
            color: var(--primary);
            margin: 24px 0 10px;
        }

        .legal-content ul {
            padding-left: 20px;
            margin-bottom: 16px;
        }

        .legal-content li {
            margin-bottom: 6px;
        }

        /* Footer */
        footer {
            background: #03060a;
            border-top: 1px solid var(--border);
            padding: 60px 24px 30px;
            position: relative;
            z-index: 1;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h5 {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 16px;
            letter-spacing: 0.5px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 10px;
        }

        .footer-col a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.2s;
        }

        .footer-col a:hover {
            color: var(--primary);
        }

        .footer-bottom {
            max-width: 1200px;
            margin: 0 auto;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            text-align: center;
            font-size: 12px;
            color: #64748b;
        }

        @media (max-width: 768px) {
            .hero h2 { font-size: 34px; }
            nav ul { display: none; }
            .legal-content { padding: 24px; }
            .publisher-card { padding: 24px; }
        }
    </style>
</head>
